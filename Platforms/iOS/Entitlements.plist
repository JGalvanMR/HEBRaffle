<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!--
        iOS Entitlements – HEB Raffle
        ─────────────────────────────
        Conjunto mínimo para code-signing correcto.
        Agregar aquí: Push Notifications, iCloud, Sign in with Apple,
        App Groups, etc., cuando la app lo requiera.
    -->

    <!--
        Data Protection: NSFileProtectionCompleteUntilFirstUserAuthentication
        ── Los archivos (DB SQLite + Excel exportados) son accesibles tras el
           primer desbloqueo del dispositivo, lo que permite operaciones de
           base de datos en background sin bloquear el acceso.
        ── Más seguro que NSFileProtectionNone pero compatible con app offline.
    -->
    <key>com.apple.developer.default-data-protection</key>
    <string>NSFileProtectionCompleteUntilFirstUserAuthentication</string>

</dict>
</plist>