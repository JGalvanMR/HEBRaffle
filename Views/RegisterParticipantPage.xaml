<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HEBRaffle.Views.RegisterParticipantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:HEBRaffle.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:RegisterParticipantViewModel"
    Style="{StaticResource PageBase}">

    <!--  Success Toast (overlay)  -->
    <ContentPage.Triggers>
        <DataTrigger
            Binding="{Binding ShowSuccess}"
            TargetType="ContentPage"
            Value="True">
            <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
    </ContentPage.Triggers>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="0,0,0,40" Spacing="0">

                <!--  Header stripe  -->
                <BoxView HeightRequest="4" Color="{StaticResource HEBRed}" />

                <VerticalStackLayout Padding="24,24" Spacing="24">

                    <!--  Form Card  -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="20">

                            <Label Style="{StaticResource SectionHeader}" Text="Participant Information" />

                            <!--  First Name  -->
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    Style="{StaticResource BodyText}"
                                    Text="First Name *" />
                                <Border
                                    Padding="4,0"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1.5">
                                    <Border.Stroke>
                                        <Binding
                                            Converter="{StaticResource StringNotEmpty}"
                                            ConverterParameter="Binding"
                                            Path="FirstNameError">
                                            <Binding.FallbackValue>
                                                <SolidColorBrush Color="{StaticResource Surface300}" />
                                            </Binding.FallbackValue>
                                        </Binding>
                                    </Border.Stroke>
                                    <Entry
                                        x:Name="EntryFirstName"
                                        Placeholder="Enter first name"
                                        ReturnType="Next"
                                        Style="{StaticResource FormEntry}"
                                        Text="{Binding FirstName}" />
                                </Border>
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding FirstNameError, Converter={StaticResource StringNotEmpty}}"
                                    Text="{Binding FirstNameError}"
                                    TextColor="{StaticResource ErrorRed}" />
                            </VerticalStackLayout>

                            <!--  Last Name  -->
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    Style="{StaticResource BodyText}"
                                    Text="Last Name *" />
                                <Border
                                    Padding="4,0"
                                    Stroke="{StaticResource Surface300}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1.5">
                                    <Entry
                                        Placeholder="Enter last name"
                                        ReturnType="Next"
                                        Style="{StaticResource FormEntry}"
                                        Text="{Binding LastName}" />
                                </Border>
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding LastNameError, Converter={StaticResource StringNotEmpty}}"
                                    Text="{Binding LastNameError}"
                                    TextColor="{StaticResource ErrorRed}" />
                            </VerticalStackLayout>

                            <!--  Store  -->
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    Style="{StaticResource BodyText}"
                                    Text="Store *" />
                                <Border
                                    Padding="4,0"
                                    Stroke="{StaticResource Surface300}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1.5">
                                    <Entry
                                        Placeholder="e.g. HEB #045 Austin"
                                        ReturnType="Next"
                                        Style="{StaticResource FormEntry}"
                                        Text="{Binding Store}" />
                                </Border>
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding StoreError, Converter={StaticResource StringNotEmpty}}"
                                    Text="{Binding StoreError}"
                                    TextColor="{StaticResource ErrorRed}" />
                            </VerticalStackLayout>

                            <!--  Years in Company  -->
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    Style="{StaticResource BodyText}"
                                    Text="Years in the Company *" />
                                <Border
                                    Padding="4,0"
                                    Stroke="{StaticResource Surface300}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1.5">
                                    <Entry
                                        Keyboard="Numeric"
                                        Placeholder="e.g. 7"
                                        ReturnType="Done"
                                        Style="{StaticResource FormEntry}"
                                        Text="{Binding YearsInCompanyText}" />
                                </Border>
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding YearsError, Converter={StaticResource StringNotEmpty}}"
                                    Text="{Binding YearsError}"
                                    TextColor="{StaticResource ErrorRed}" />
                            </VerticalStackLayout>

                            <!--  Error Banner  -->
                            <Border
                                Padding="14,10"
                                BackgroundColor="{StaticResource ErrorLight}"
                                IsVisible="{Binding HasError}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                                <Label
                                    FontSize="14"
                                    Text="{Binding ErrorMessage}"
                                    TextColor="{StaticResource ErrorRed}" />
                            </Border>

                        </VerticalStackLayout>
                    </Border>

                    <!--  Action Buttons  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            Command="{Binding ClearFormCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Text="Clear Form" />

                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryButton}"
                            Text="{Binding SaveButtonText}" />
                    </Grid>

                    <!--  Busy Indicator  -->
                    <ActivityIndicator
                        HeightRequest="40"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource HEBRed}" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!--  ── Success Toast ────────────────────────────────────────────────  -->
        <Border
            Margin="24,0,24,40"
            Padding="20,14"
            BackgroundColor="{StaticResource SuccessGreen}"
            HorizontalOptions="Fill"
            IsVisible="{Binding ShowSuccess}"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="0"
            VerticalOptions="End"
            ZIndex="100">
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.2"
                    Radius="12"
                    Offset="0,4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label
                    Grid.Column="0"
                    FontSize="20"
                    Text="✅"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="{Binding SuccessMessage}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
