<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HEBRaffle.Views.WinnersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:HEBRaffle.Models"
    xmlns:vm="clr-namespace:HEBRaffle.ViewModels"
    Title="Winners"
    x:DataType="vm:WinnersViewModel"
    Style="{StaticResource PageBase}">

    <Shell.TitleView>
        <Grid Padding="0,0,12,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="🏆  Winners"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Padding="8,0"
                BackgroundColor="Transparent"
                Command="{Binding ExportCommand}"
                FontSize="13"
                Text="⬇ Export"
                TextColor="White" />
        </Grid>
    </Shell.TitleView>

    <Grid>
        <VerticalStackLayout Spacing="0">

            <!--  Gold header stripe  -->
            <Grid Padding="24,28,24,24" Background="{StaticResource HEBGoldGradient}">
                <Grid
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="4">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="26"
                        Text="Raffle Winners"
                        TextColor="{StaticResource OnSurface900}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="13"
                        Text="HEB Corporate Event — Fruits &amp; Vegetables Leaders"
                        TextColor="{StaticResource OnSurface700}" />
                    <!--  Total badge  -->
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Padding="16,10"
                        BackgroundColor="#33000000"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <VerticalStackLayout Spacing="0">
                            <Label
                                FontAttributes="Bold"
                                FontSize="32"
                                HorizontalOptions="Center"
                                Text="{Binding TotalWinners}"
                                TextColor="{StaticResource OnSurface900}" />
                            <Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="Winners"
                                TextColor="{StaticResource OnSurface700}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>

            <!--  Empty state  -->
            <VerticalStackLayout
                Padding="40,60"
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Spacing="16"
                VerticalOptions="Center">
                <Label
                    FontSize="64"
                    HorizontalOptions="Center"
                    Text="🎲" />
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="No winners yet"
                    TextColor="{StaticResource OnSurface700}" />
                <Label
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    Text="Run a raffle draw to select winners."
                    TextColor="{StaticResource OnSurface500}" />
                <Button
                    Command="{Binding GoToRaffleCommand}"
                    HorizontalOptions="Center"
                    Style="{StaticResource PrimaryButton}"
                    Text="Go to Raffle" />
            </VerticalStackLayout>

            <!--  Winners list  -->
            <RefreshView
                Command="{Binding LoadCommand}"
                IsRefreshing="{Binding IsBusy}"
                IsVisible="{Binding IsEmpty, Converter={StaticResource InvertBool}}">

                <CollectionView ItemsSource="{Binding Winners}" SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Winner">

                            <Border
                                Margin="12,6"
                                Padding="0"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#FFFBF0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Shadow>
                                    <Shadow
                                        Brush="Black"
                                        Opacity="0.07"
                                        Radius="8"
                                        Offset="0,2" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">

                                    <!--  Prize number sidebar  -->
                                    <Grid
                                        Grid.Column="0"
                                        Background="{StaticResource HEBGoldGradient}"
                                        WidthRequest="60">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Rotation="-90"
                                            Text="{Binding PrizeNumber, StringFormat='#{0}'}"
                                            TextColor="{StaticResource OnSurface900}"
                                            TranslationY="0"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <!--  Participant info  -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Padding="16,14"
                                        Spacing="4">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            Text="{Binding Participant.FullName}"
                                            TextColor="{StaticResource OnSurface900}" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding Participant.Store}"
                                            TextColor="{StaticResource OnSurface500}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Participant.YearsLabel}"
                                            TextColor="{StaticResource OnSurface400}" />
                                        <Label
                                            FontSize="11"
                                            Text="{Binding DrawDateLocal}"
                                            TextColor="{StaticResource OnSurface300}" />
                                    </VerticalStackLayout>

                                    <!--  Trophy icon  -->
                                    <Label
                                        Grid.Column="2"
                                        Padding="0,0,16,0"
                                        FontSize="28"
                                        Text="🏆"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="24" Color="Transparent" />
                    </CollectionView.Footer>

                </CollectionView>
            </RefreshView>

        </VerticalStackLayout>

        <!--  Export Toast  -->
        <Border
            Margin="24,0,24,40"
            Padding="20,14"
            BackgroundColor="{StaticResource SuccessGreen}"
            IsVisible="{Binding ShowExportToast}"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="0"
            VerticalOptions="End"
            ZIndex="100">
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.2"
                    Radius="12"
                    Offset="0,4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label
                    Grid.Column="0"
                    FontSize="20"
                    Text="📊"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="{Binding ExportMessage}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
