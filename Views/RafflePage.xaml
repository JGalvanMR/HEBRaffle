<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HEBRaffle.Views.RafflePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:HEBRaffle.Models"
    xmlns:vm="clr-namespace:HEBRaffle.ViewModels"
    Title="Raffle Draw"
    x:DataType="vm:RaffleViewModel"
    Style="{StaticResource PageBase}">

    <Shell.TitleView>
        <Grid Padding="0,0,4,0" ColumnDefinitions="*,Auto,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="🎲  Raffle Draw"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Padding="8,0"
                BackgroundColor="Transparent"
                Command="{Binding ViewWinnersCommand}"
                FontSize="13"
                Text="Winners"
                TextColor="White" />
            <Button
                Grid.Column="2"
                Padding="8,0"
                BackgroundColor="Transparent"
                Command="{Binding ExportWinnersCommand}"
                FontSize="13"
                Text="⬇ Export"
                TextColor="White" />
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!--  ── Stage: Animation area ────────────────────────────────  -->
            <Grid
                Padding="24,40,24,40"
                Background="{StaticResource DashboardHeaderGradient}"
                MinimumHeightRequest="260">

                <VerticalStackLayout Spacing="16" VerticalOptions="Center">

                    <!--  Status label  -->
                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="{Binding StatusMessage}"
                        TextColor="#CCFFFFFF" />

                    <!--  Animated name drum roll  -->
                    <Border
                        x:Name="AnimationBorder"
                        Padding="24,20"
                        BackgroundColor="#22FFFFFF"
                        HorizontalOptions="Fill"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="{Binding AnimatedName}"
                            TextColor="White" />
                    </Border>

                    <!--  Winner reveal panel  -->
                    <Border
                        Padding="20,16"
                        BackgroundColor="{StaticResource HEBGold}"
                        HorizontalOptions="Fill"
                        IsVisible="{Binding ShowResult}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                HorizontalOptions="Center"
                                Text="{Binding ResultPrize, StringFormat='🏆  Prize #{0}'}"
                                TextColor="{StaticResource OnSurface900}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="26"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding ResultName}"
                                TextColor="{StaticResource OnSurface900}" />
                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="{Binding ResultStore}"
                                TextColor="{StaticResource OnSurface700}" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Spinner during draw  -->
                    <ActivityIndicator
                        HeightRequest="28"
                        IsRunning="{Binding IsAnimating}"
                        IsVisible="{Binding IsAnimating}"
                        Color="White" />

                </VerticalStackLayout>
            </Grid>

            <!--  ── Controls ─────────────────────────────────────────────  -->
            <VerticalStackLayout Padding="20,24" Spacing="20">

                <!--  Number of winners picker  -->
                <Border Style="{StaticResource Card}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="16">

                        <Label
                            Grid.Row="0"
                            Style="{StaticResource SectionHeader}"
                            Text="NUMBER OF WINNERS" />

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="16"
                            VerticalOptions="Center">

                            <Button
                                Grid.Column="0"
                                BackgroundColor="{StaticResource Surface200}"
                                Command="{Binding DecrementWinnersCommand}"
                                CornerRadius="26"
                                FontAttributes="Bold"
                                FontSize="24"
                                HeightRequest="52"
                                Text="−"
                                TextColor="{StaticResource OnSurface900}"
                                WidthRequest="52" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                HorizontalOptions="Center"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="48"
                                    HorizontalOptions="Center"
                                    Text="{Binding NumberOfWinners}"
                                    TextColor="{StaticResource HEBRed}" />
                                <Label
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding EligibleCount, StringFormat='of {0} eligible'}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                BackgroundColor="{StaticResource Surface200}"
                                Command="{Binding IncrementWinnersCommand}"
                                CornerRadius="26"
                                FontAttributes="Bold"
                                FontSize="24"
                                HeightRequest="52"
                                Text="+"
                                TextColor="{StaticResource OnSurface900}"
                                WidthRequest="52" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  Draw Button  -->
                <Button
                    Command="{Binding DrawCommand}"
                    FontSize="18"
                    HeightRequest="60"
                    IsEnabled="{Binding CanDraw}"
                    Style="{StaticResource PrimaryButton}"
                    Text="🎲  START DRAW" />

                <!--  Session winners summary  -->
                <Border IsVisible="{Binding HasSessionWinners}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Style="{StaticResource SectionHeader}"
                                Text="SESSION WINNERS" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource CaptionText}"
                                Text="{Binding SessionWinners.Count, StringFormat='{0} total'}"
                                VerticalOptions="Center" />
                        </Grid>

                        <CollectionView
                            HeightRequest="220"
                            ItemsSource="{Binding SessionWinners}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Winner">
                                    <Grid
                                        Padding="0,6"
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="12">

                                        <!--  Prize number badge  -->
                                        <Border
                                            Grid.Column="0"
                                            BackgroundColor="{StaticResource HEBGold}"
                                            HeightRequest="36"
                                            StrokeShape="Ellipse"
                                            StrokeThickness="0"
                                            WidthRequest="36">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                HorizontalOptions="Center"
                                                Text="{Binding PrizeNumber}"
                                                TextColor="{StaticResource OnSurface900}"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding Participant.FullName}"
                                                TextColor="{StaticResource OnSurface900}" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding Participant.Store}"
                                                TextColor="{StaticResource OnSurface500}" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            FontSize="18"
                                            Text="🏆"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!--  Reset button  -->
                <Button
                    BorderColor="{StaticResource ErrorRed}"
                    Command="{Binding ResetRaffleCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="⚠  Reset Raffle"
                    TextColor="{StaticResource ErrorRed}" />

                <BoxView HeightRequest="20" Color="Transparent" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
