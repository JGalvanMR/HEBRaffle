<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HEBRaffle.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:HEBRaffle.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource PageBase}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

            <!--  ── Header ────────────────────────────────────────────────  -->
            <Grid
                x:Name="HeaderGrid"
                Grid.Row="0"
                Padding="24,52,24,32"
                Background="{StaticResource DashboardHeaderGradient}">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                    <!--  HEB Logo placeholder / Event badge  -->
                    <Border
                        Grid.Row="0"
                        Padding="10,4"
                        BackgroundColor="#FFFFFF22"
                        HorizontalOptions="Start"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <Label
                            CharacterSpacing="0.8"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="🛒  HEB Corporate Event"
                            TextColor="White" />
                    </Border>

                    <Label
                        Grid.Row="1"
                        FontAttributes="Bold"
                        FontSize="34"
                        Text="Raffle Manager"
                        TextColor="White" />

                    <Label
                        Grid.Row="2"
                        FontSize="14"
                        Text="{Binding EventStatus}"
                        TextColor="#CCFFFFFF" />
                </Grid>
            </Grid>

            <!--  ── Stat Cards ─────────────────────────────────────────────  -->
            <Grid
                Grid.Row="1"
                Padding="16,20,16,0"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12">

                <!--  Total  -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="👥" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="{Binding TotalParticipants}"
                            TextColor="{StaticResource HEBRed}" />
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource CaptionText}"
                            Text="Total" />
                    </VerticalStackLayout>
                </Border>

                <!--  Eligible  -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="✅" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="{Binding EligibleParticipants}"
                            TextColor="{StaticResource SuccessGreen}" />
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource CaptionText}"
                            Text="Eligible" />
                    </VerticalStackLayout>
                </Border>

                <!--  Winners  -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="🏆" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="{Binding TotalWinners}"
                            TextColor="{StaticResource HEBGold}" />
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource CaptionText}"
                            Text="Winners" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!--  ── Action Grid ─────────────────────────────────────────────  -->
            <Grid
                Grid.Row="2"
                Padding="16,24,16,32"
                ColumnDefinitions="*,*"
                ColumnSpacing="16"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="16">

                <!--  Register  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="0">
                        <BoxView
                            Grid.Row="0"
                            CornerRadius="16,16,0,0"
                            HeightRequest="6"
                            Color="{StaticResource HEBRed}" />
                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="20,16"
                            Spacing="8">
                            <Label FontSize="32" Text="📝" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Register"
                                TextColor="{StaticResource OnSurface900}" />
                            <Label Style="{StaticResource CaptionText}" Text="Add new participant" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Participants  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="0"
                    Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToParticipantsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="0">
                        <BoxView
                            Grid.Row="0"
                            CornerRadius="16,16,0,0"
                            HeightRequest="6"
                            Color="{StaticResource InfoBlue}" />
                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="20,16"
                            Spacing="8">
                            <Label FontSize="32" Text="👥" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Participants"
                                TextColor="{StaticResource OnSurface900}" />
                            <Label Style="{StaticResource CaptionText}" Text="View &amp; manage list" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Raffle  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRaffleCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="0">
                        <BoxView
                            Grid.Row="0"
                            CornerRadius="16,16,0,0"
                            HeightRequest="6"
                            Color="{StaticResource HEBGold}" />
                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="20,16"
                            Spacing="8">
                            <Label FontSize="32" Text="🎲" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Raffle"
                                TextColor="{StaticResource OnSurface900}" />
                            <Label Style="{StaticResource CaptionText}" Text="Run the draw" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Winners  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="0"
                    Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToWinnersCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="0">
                        <BoxView
                            Grid.Row="0"
                            CornerRadius="16,16,0,0"
                            HeightRequest="6"
                            Color="{StaticResource SuccessGreen}" />
                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="20,16"
                            Spacing="8">
                            <Label FontSize="32" Text="🏆" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Winners"
                                TextColor="{StaticResource OnSurface900}" />
                            <Label Style="{StaticResource CaptionText}" Text="View all winners" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  Import — full width, Row 2  -->
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Padding="0"
                    Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToImportCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*" RowSpacing="0">
                        <BoxView
                            Grid.Row="0"
                            CornerRadius="16,16,0,0"
                            HeightRequest="6"
                            Color="#7B1FA2" />
                        <Grid
                            Grid.Row="1"
                            Padding="20,16"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="16">
                            <Label
                                Grid.Column="0"
                                FontSize="32"
                                Text="📂"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    Text="Import from Excel"
                                    TextColor="{StaticResource OnSurface900}" />
                                <Label Style="{StaticResource CaptionText}" Text="Load participants from .xlsx file" />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </ScrollView>

    <!--  Loading overlay  -->
    <ContentPage.Triggers>
        <DataTrigger
            Binding="{Binding IsBusy}"
            TargetType="ContentPage"
            Value="True">
            <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
    </ContentPage.Triggers>

</ContentPage>
